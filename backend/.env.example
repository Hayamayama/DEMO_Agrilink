PORT=3000
# --- Demo-only shell ---
# Enables the guided judge flow at /api/demo. Never add these settings to the
# production project. Use one fictional seeded member, for example 9100000001.
DEMO_MODE=false
DEMO_USER_PHONE=
# DEMO_USER_PIN=246810
# APP_COMMIT=              # optional deployment receipt; falls back to Git SHA
# PostgreSQL must remain private to the VM. Copy the real URL from the VM's
# mode-600 config file; never commit a credential here.
# DATABASE_URL=postgresql://agrilink_app:<password>@127.0.0.1:5432/agrilink
# Daily mandi prices (db/syncMandi.js, every 30 min on the VM). Without a key the job uses
# data.gov.in's published sample key: shared, 10 records per request, often rate limited.
# MANDI_API_KEY=
# MANDI_MAX_WAIT_MIN=20
# --- Ask AI (Gemini) ---
# GEMINI_API_KEY is supplied on the server only. Leave it blank here.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=12000
AI_MAX_OUTPUT_TOKENS=500
# Ask AI and TTS need a signed-in member; limits are per member plus a server-wide daily cap.
AI_RATE_LIMIT_PER_MINUTE=15
AI_RATE_LIMIT_PER_DAY=300
AI_GLOBAL_LIMIT_PER_DAY=1500
AI_CACHE_TTL_SECONDS=600

# CEDA Agri Market Data. Keep the real token only in backend/.env (mode 600).
# CEDA_API_TOKEN=
# Fill these after running `node db/syncCeda.js catalog`, `geographies`, and `markets`.
# CEDA_COMMODITY_ID=
# CEDA_CROP_CODE=rice
# CEDA_CROP_NAME=Rice
# CEDA_STATE_ID=
# CEDA_DISTRICT_ID=          # used only by the `markets` discovery command
# CEDA_DISTRICT_IDS=         # comma-separated IDs used by sync
# CEDA_MARKET_IDS=           # comma-separated IDs used by sync
# CEDA_FROM_DATE=2026-09-01
# CEDA_TO_DATE=2026-09-19

# --- Cloud TTS Broadcaster ---
# Uses the same GEMINI_API_KEY above. No additional billing needed.
# TTS_MODEL=gemini-1.5-flash-8b
# TTS_MAX_CHARS=2000
# TTS_TIMEOUT_MS=15000
# TTS_RATE_LIMIT_PER_MINUTE=30
# TTS_RATE_LIMIT_PER_DAY=500
# TTS_GLOBAL_LIMIT_PER_DAY=300


# --- Farmer Circle (forum, PostgreSQL schema app.forum_*) ---
# Needs migration 005 (npm run db:migrate as the migrator role) and the auth settings above.
# Demo content: fictional posts + members (phones 9100000001-9100000005). On a production host set
# DEMO_USER_PIN (6 digits) explicitly; there is no built-in PIN when NODE_ENV=production.
SEED_DEMO_DATA=false
DEMO_USER_PIN=
MAX_POSTS_PER_HOUR=5
MAX_REPLIES_PER_HOUR=20
