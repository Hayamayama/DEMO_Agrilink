PORT=3000
# PostgreSQL must remain private to the VM. Copy the real URL from the VM's
# mode-600 config file; never commit a credential here.
# DATABASE_URL=postgresql://agrilink_app:<password>@127.0.0.1:5432/agrilink
# DATA_GOV_IN_KEY=
# --- Ask AI (Gemini) ---
# GEMINI_API_KEY is supplied on the server only. Leave it blank here.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=12000
AI_MAX_OUTPUT_TOKENS=500
AI_RATE_LIMIT_PER_MINUTE=15
AI_RATE_LIMIT_PER_DAY=300
AI_CACHE_TTL_SECONDS=600

# CEDA Agri Market Data. Keep the real token only in backend/.env (mode 600).
# CEDA_API_TOKEN=
# Fill these after running `node db/syncCeda.js catalog`, `geographies`, and `markets`.
# CEDA_COMMODITY_ID=
# CEDA_CROP_CODE=rice
# CEDA_CROP_NAME=Rice
# CEDA_STATE_ID=
# CEDA_DISTRICT_ID=          # used only by the `markets` discovery command
# CEDA_DISTRICT_IDS=         # comma-separated IDs used by sync
# CEDA_MARKET_IDS=           # comma-separated IDs used by sync
# CEDA_FROM_DATE=2026-09-01
# CEDA_TO_DATE=2026-09-19
